<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NostalgicHub</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #080808;
      color: white;
      font-family: Arial, sans-serif;
      overflow: hidden;
    }

    /* Intro screen */
    .intro {
      position: fixed;
      inset: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #080808;
      z-index: 9999;
      animation: introFade 1.5s ease forwards;
      animation-delay: 3.5s;
    }

    .intro h1 {
      font-size: clamp(2.5rem, 7vw, 6rem);
      font-weight: 600;
      letter-spacing: 4px;
      opacity: 0;
      animation: textFade 2s ease forwards;
    }

    .intro h1 span {
      color: #888;
    }

    /* Main website */
    .main {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .main h2 {
      font-size: 3rem;
    }

    /* Text fade in */
    @keyframes textFade {
      0% {
        opacity: 0;
        transform: translateY(15px);
        filter: blur(8px);
      }

      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }

    /* Fade intro away */
    @keyframes introFade {
      0% {
        opacity: 1;
        visibility: visible;
      }

      100% {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
    }
  </style>
</head>

<body>

  <!-- Intro -->
  <div class="intro">
    <h1>
      Welcome to <span>NostalgicHub</span>
    </h1>
  </div>

  <!-- Your actual website -->
  <main class="main">
    <h2>NostalgicHub</h2>
  </main>

</body>
</html>
